// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("REAL_DATABASE_URL")
  directUrl = env("REAL_DIRECT_URL")
}

// Note: SQLite does not support enums, so we use String fields instead.
// Valid values for role: PROFESSOR, PHD, MS, BS, ALUMNI
// Valid values for postType: NOTICE, FREE
// Valid values for resourceType: EQUIPMENT, ROOM
// Valid values for reservationStatus: PENDING, APPROVED, REJECTED, CANCELLED

model User {
  id                String        @id @default(cuid())
  name              String?
  email             String?       @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  role              String        @default("BS")
  isAdmin           Boolean       @default(false)
  isApproved        Boolean       @default(false)  // false = Guest, true = Member
  bio               String?
  researchInterests String?       // JSON array stored as string
  joinedAt          DateTime      @default(now())
  graduatedAt       DateTime?
  // 졸업생 정보
  currentCompany    String?       // 현재 직장
  currentPosition   String?       // 현재 직책
  degreeObtained    String?       // 취득 학위 (MS, PhD)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  accounts          Account[]
  sessions          Session[]
  posts             Post[]
  comments          Comment[]
  reservations      Reservation[]
  events            CalendarEvent[]
  materialsUploaded Material[]     @relation("MaterialUploader")
  materialsPresented Material[]    @relation("MaterialPresenter")
  tasks             Task[]         @relation("TaskAuthor")
  taskComments      TaskComment[]  @relation("TaskCommentAuthor")
  projectMembers    ProjectMember[]
  workspaceMembers  WorkspaceMember[]
  workspaceResources WorkspaceResource[] @relation("WorkspaceResourceUploader")
  materialFeedbacks MaterialFeedback[]

  // Lab Resource Management relations
  inventoryTransactions InventoryTransaction[] @relation("InventoryPerformer")
  purchaseRequests      PurchaseRequest[]      @relation("PurchaseRequester")
  purchaseApprovals     PurchaseRequest[]      @relation("PurchaseApprover")
  ledgerAccounts        LedgerAccount[]        @relation("LedgerRecorder")
  networkAssets         NetworkAsset[]         @relation("NetworkAssetOwner")

  // Post interactions
  postLikes             PostLike[]
  pollVotes             PollVote[]

  // Lab Meeting
  labMeetingPresentations LabMeetingPresenter[]

  // Meeting Transcription (음성 녹음 → 텍스트 변환)
  transcriptionsAsRecorder   MeetingTranscription[] @relation("TranscriptionRecorder")

  // Medal System (훈장 시스템)
  medalPoints      Int            @default(0)  // 누적 훈장 포인트 (MVP=2, 우수=1)
  medalAwards      MedalAward[]   @relation("MedalRecipient")
  medalAwardsGiven MedalAward[]   @relation("MedalAwarder")

  // Paper Management (논문 관리)
  labPapersUploaded LabPaper[]       @relation("LabPaperUploader")
  labPaperAuthored  LabPaperAuthor[] @relation("LabPaperAuthor")
  paperRevisions    PaperRevision[]  @relation("PaperRevisionUploader")
  readingPapers     ReadingPaper[]   @relation("ReadingPaperReader")

  // Material Partitions (자료 파티션)
  materialPartitions MaterialPartition[] @relation("PartitionCreator")

  // Timetable (시간표)
  timetable          Timetable?          @relation("TimetableOwner")

  // Google Calendar (구글 캘린더 연동)
  googleCalendars    GoogleCalendarSync[]
  labNote            LabNote?
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Post {
  id          String       @id @default(cuid())
  title       String
  content     String
  type        String       @default("FREE") // NOTICE, FREE, SEMINAR
  isPinned    Boolean      @default(false)
  authorId    String
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments    Comment[]
  attachments Attachment[]
  likes       PostLike[]
  poll        Poll?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attachment {
  id        String   @id @default(cuid())
  filename  String
  url       String
  size      Int
  mimeType  String
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Resource {
  id           String       @id @default(cuid())
  name         String
  description  String?
  type         String       @default("EQUIPMENT")
  image        String?
  isAvailable  Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  reservations Reservation[]
}

model Reservation {
  id         String   @id @default(cuid())
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startTime  DateTime
  endTime    DateTime
  status     String   @default("PENDING")
  purpose    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  isAllDay    Boolean  @default(false)
  isImportant Boolean  @default(false)
  category    String   @default("OTHER") // SEMINAR, MEETING, LAB_MEETING, DEADLINE, TRIP, VACATION, OTHER
  color       String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  content   String
  isActive  Boolean   @default(true)
  priority  Int       @default(0)
  startDate DateTime  @default(now())
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Material {
  id            String      @id @default(cuid())
  title         String
  description   String?
  category      String      @default("OTHER") // PAPER, PPT, DATA, LAB_MEETING, OTHER
  filename      String
  url           String
  size          Int
  mimeType      String
  uploaderId    String
  uploader      User        @relation("MaterialUploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  presenterId   String?     // 실제 발표한 사람 (업로더와 다를 수 있음)
  presenter     User?       @relation("MaterialPresenter", fields: [presenterId], references: [id], onDelete: SetNull)
  labMeetingId  String?
  labMeeting    LabMeeting? @relation(fields: [labMeetingId], references: [id], onDelete: SetNull)
  partitionId   String?
  partition     MaterialPartition? @relation(fields: [partitionId], references: [id], onDelete: SetNull)
  parentMaterialId String?
  parentMaterial   Material?   @relation("MaterialReferences", fields: [parentMaterialId], references: [id], onDelete: Cascade)
  referenceMaterials Material[] @relation("MaterialReferences")
  transcription MeetingTranscription?  // 연결된 트랜스크립션
  feedbacks     MaterialFeedback[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([parentMaterialId])
}

// ============ Material Feedback (교수 피드백) ============

model MaterialFeedback {
  id         String   @id @default(cuid())
  content    String
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============ Material Partition (자료 파티션) ============

model MaterialPartition {
  id          String     @id @default(cuid())
  name        String
  description String?
  emoji       String     @default("📁")
  color       String     @default("#3B82F6")
  category    String     // DATA or OTHER
  creatorId   String
  creator     User       @relation("PartitionCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  materials   Material[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// ============ Lab Meeting (랩미팅) ============

model LabMeeting {
  id             String               @id @default(cuid())
  date           DateTime             // 랩미팅 날짜
  title          String               // 제목 (예: "주간 랩미팅", "논문 세미나")
  description    String?              // 설명/메모
  materials      Material[]           // 연결된 자료들 (트랜스크립션은 Material을 통해 접근)
  presenters     LabMeetingPresenter[] // 발표자들
  medalAwards    MedalAward[]         // 훈장 수여 내역
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model LabMeetingPresenter {
  id           String     @id @default(cuid())
  labMeetingId String
  labMeeting   LabMeeting @relation(fields: [labMeetingId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([labMeetingId, userId])
}

// ============ Medal System (훈장 시스템) ============

model MedalAward {
  id            String     @id @default(cuid())
  type          String     // "MVP" (2점) or "EXCELLENT" (1점)
  recipientId   String
  recipient     User       @relation("MedalRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  awarderId     String
  awarder       User       @relation("MedalAwarder", fields: [awarderId], references: [id], onDelete: Cascade)
  labMeetingId  String
  labMeeting    LabMeeting @relation(fields: [labMeetingId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())

  @@unique([labMeetingId, recipientId])
}

// 미팅 녹음 트랜스크립션 (음성 → 텍스트 → 요약)
model MeetingTranscription {
  id            String       @id @default(cuid())
  audioUrl      String       // Supabase에 저장된 오디오 파일 URL
  audioFilename String?      // 원본 파일명
  duration      Int?         // 오디오 길이 (초)
  status        String       @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  jobId         String?      // Transcription Service job ID
  transcript    String?      // JSON string (segments array)
  summary       String?      // LLM 요약 결과
  error         String?      // 에러 메시지 (실패 시)

  // 발표자료 연결 (필수)
  materialId    String       @unique
  material      Material     @relation(fields: [materialId], references: [id], onDelete: Cascade)

  // 녹음/업로드한 사람
  recorderId    String
  recorder      User         @relation("TranscriptionRecorder", fields: [recorderId], references: [id], onDelete: Cascade)
  recorderName  String?      // 사용자 삭제 시에도 이름 유지

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

// ============ Task Management ============

model Project {
  id          String          @id @default(cuid())
  name        String
  description String?
  isActive    Boolean         @default(true)
  tasks       Task[]
  members     ProjectMember[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

model Task {
  id          String           @id @default(cuid())
  title       String
  content     String
  category    String           @default("OTHER") // PROJECT, PAPER, EXPERIMENT, OTHER
  status      String           @default("IN_PROGRESS") // IN_PROGRESS, QUESTION, ANSWERED, COMPLETED
  projectId   String?
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  authorId    String
  author      User             @relation("TaskAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  comments    TaskComment[]
  attachments TaskAttachment[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model TaskComment {
  id        String   @id @default(cuid())
  content   String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model TaskAttachment {
  id        String   @id @default(cuid())
  filename  String
  url       String
  size      Int
  mimeType  String?
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// ============ Workspace (협업공간) ============

model Workspace {
  id          String              @id @default(cuid())
  name        String
  description String?
  image       String?
  members     WorkspaceMember[]
  sections    WorkspaceSection[]
  resources   WorkspaceResource[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isLeader    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, userId])
}

model WorkspaceSection {
  id          String              @id @default(cuid())
  workspaceId String
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  order       Int                 @default(0)
  resources   WorkspaceResource[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model WorkspaceResource {
  id          String            @id @default(cuid())
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sectionId   String?
  section     WorkspaceSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  title       String
  description String?
  type        String            @default("FILE") // FILE, LINK
  filename    String?           // For FILE type
  url         String            // For LINK or file path
  size        Int?              // For FILE type
  mimeType    String?           // For FILE type
  uploaderId  String
  uploader    User              @relation("WorkspaceResourceUploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

// ============ Contact Inquiry (문의하기) ============

model ContactInquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AnonymousInquiryRoom {
  id                String                  @id @default(cuid())
  roomCode          String                  @unique
  accessCode        String
  nickname          String?
  category          String
  topic             String?
  includeTestResult Boolean                 @default(false)
  testResultTitle   String?
  testResultSummary String?
  testTopAxes       String?
  testFitScore      Int?
  policyAcceptedAt  DateTime?
  createdIpAddress  String?
  createdIpMasked   String?
  createdUserAgent  String?
  lastVisitorIpAddress String?
  lastVisitorIpMasked  String?
  lastVisitorUserAgent String?
  status            String                  @default("OPEN") // OPEN, ANSWERED, CLOSED
  lastMessageAt     DateTime                @default(now())
  lastAdminReadAt   DateTime?
  lastVisitorReadAt DateTime?
  messages          AnonymousInquiryMessage[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([createdAt])
  @@index([lastMessageAt])
  @@index([createdIpAddress])
  @@index([lastVisitorIpAddress])
}

model AnonymousInquiryMessage {
  id              String               @id @default(cuid())
  roomId          String
  room            AnonymousInquiryRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderType      String               // VISITOR, ADMIN
  content         String
  senderIpAddress String?
  senderIpMasked  String?
  senderUserAgent String?
  createdAt       DateTime             @default(now())

  @@index([roomId, createdAt])
  @@index([senderIpAddress])
}

model LabNote {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  draftDisplayLabel  String?
  draftContent       String?
  draftTheme         String   @default("SKY")
  publicDisplayLabel String?
  publicContent      String?
  publicTheme        String   @default("SKY")
  status             String   @default("EMPTY") // EMPTY, PENDING, APPROVED, NEEDS_EDIT
  adminComment       String?
  lastSubmittedAt    DateTime?
  approvedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status])
  @@index([approvedAt])
}

// ============ Publications (논문 및 특허) ============
// Valid values for publicationType: JOURNAL, CONFERENCE, PATENT, BOOK

model Publication {
  id          String   @id @default(cuid())
  type        String   // JOURNAL, CONFERENCE, PATENT, BOOK
  title       String
  authors     String   // Comma-separated author names
  year        Int
  journal     String?  // For journal/conference papers
  volume      String?  // Volume number
  pages       String?  // Page range
  doi         String?  // Digital Object Identifier
  patentNo    String?  // Patent number (for patents)
  link        String?  // External link to full paper/patent
  isHighlight Boolean  @default(false)  // Featured publication
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============ Site Settings (사이트 설정) ============

model SiteSettings {
  id              String   @id @default("main")
  videoEnabled    Boolean  @default(false)  // Enable video hover on research cards
  alumniVisible   Boolean  @default(false)  // 외부인에게 졸업생 섹션 표시 여부
  updatedAt       DateTime @updatedAt
}

// ============ Professor Info (교수 정보) ============

model ProfessorInfo {
  id              String   @id @default("main")
  
  // 기본 정보
  name            String   @default("교수명")
  position        String   @default("부교수")
  department      String   @default("생명화학공학과")
  university      String   @default("강원대학교")
  address         String   @default("")  // 주소
  profileImage    String?  // Supabase URL
  
  // 연락처
  email           String   @default("")
  phone           String   @default("")
  fax             String   @default("")  // 팩스
  labLocation     String   @default("")
  
  // 학력 (JSON array) - [{ degree, school, major, year, thesis, advisor }]
  education       String   @default("[]")
  
  // 경력 (JSON array) - [{ position, organization, period, description }]
  career          String   @default("[]")
  
  // 학술 활동 (JSON array) - [{ category, items: string[] }]
  academicActivities String @default("[]")
  
  // 수상 및 명예 (JSON array) - [{ title, year }]
  awards          String   @default("[]")
  
  // 연구 분야
  researchKeywords    String   @default("[]")  // JSON array of strings
  researchDescription String   @default("")
  
  updatedAt       DateTime @updatedAt
}

// ============ Lab Resource Management (연구실 자원관리) ============

// 시약/소모품 (Inventory Item)
model InventoryItem {
  id            String              @id @default(cuid())
  name          String              // 품명
  category      String              @default("OTHER")  // REAGENT, CONSUMABLE, EQUIPMENT, OTHER
  quantity      Int                 @default(0)        // 현재 수량
  unit          String              @default("개")     // 단위 (개, ml, g, 박스 등)
  minQuantity   Int                 @default(0)        // 최소 재고량 (이하시 알림)
  location      String?             // 보관 위치
  expiryDate    DateTime?           // 유효기간
  manufacturer  String?             // 제조사
  catalogNo     String?             // 카탈로그 번호
  purchaseUrl   String?             // 구매 링크
  msdsUrl       String?             // MSDS 파일 URL
  notes         String?             // 비고
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  
  transactions  InventoryTransaction[]
}

// 입출고 기록
model InventoryTransaction {
  id            String         @id @default(cuid())
  itemId        String
  item          InventoryItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type          String         // IN (입고), OUT (출고)
  quantity      Int            // 수량 (양수)
  reason        String?        // 사유 (구매, 사용, 폐기 등)
  performedById   String?
  performedBy     User?          @relation("InventoryPerformer", fields: [performedById], references: [id], onDelete: SetNull)
  performedByName String?        // 사용자 삭제 시에도 이름 유지
  createdAt     DateTime       @default(now())
}

// 구매 요청
model PurchaseRequest {
  id            String              @id @default(cuid())
  title         String              // 제목
  description   String?             // 설명
  category      String              @default("OTHER")  // REAGENT, EQUIPMENT, OFFICE, TRAVEL, OTHER
  priority      String              @default("NORMAL") // URGENT, NORMAL
  estimatedCost Int                 // 예상 금액 (원)
  actualCost    Int?                // 실제 금액 (승인 후)
  status        String              @default("PENDING") // PENDING, APPROVED, REJECTED, PURCHASED
  quotationUrl  String?             // 견적서 URL
  receiptUrl    String?             // 영수증 URL
  rejectReason  String?             // 반려 사유
  requesterId     String?
  requester       User?               @relation("PurchaseRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  requesterName   String?             // 사용자 삭제 시에도 이름 유지
  approverId      String?
  approver        User?               @relation("PurchaseApprover", fields: [approverId], references: [id], onDelete: SetNull)
  approverName    String?             // 사용자 삭제 시에도 이름 유지
  approvedAt    DateTime?
  purchasedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  items         PurchaseItem[]
}

// 구매 요청 품목
model PurchaseItem {
  id            String          @id @default(cuid())
  requestId     String
  request       PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  name          String          // 품명
  quantity      Int             // 수량
  unitPrice     Int?            // 단가
  url           String?         // 구매 링크
}

// 장부 계좌 (항목별 잔액)
model LedgerAccount {
  id            String   @id @default(cuid())
  section       String   @default("기본") // 섹션 (예: 연구비, 인건비, 기자재)
  sectionOrder  Int      @default(0)  // 섹션 표시 순서 (낮을수록 위)
  name          String   // 항목명
  initialBalance Int     @default(0)  // 초기 잔액 (원)
  balance       Int      @default(0)  // 현재 잔액 (원, 초기잔액 + 거래합계)
  description   String?  // 설명
  recordedById    String?
  recordedBy      User?    @relation("LedgerRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  recordedByName  String?  // 사용자 삭제 시에도 이름 유지
  transactions  LedgerTransaction[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 장부 거래 내역
model LedgerTransaction {
  id            String        @id @default(cuid())
  accountId     String
  account       LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date          DateTime      // 거래일
  description   String        // 내역
  expense       Int           @default(0)  // 지출 (원)
  income        Int           @default(0)  // 입금 (원)
  balance       Int           @default(0)  // 거래 후 잔액 (원)
  note          String?       // 비고
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// Network IP/MAC management
model NetworkAsset {
  id          String   @id @default(cuid())
  ownerId     String?
  owner       User?    @relation("NetworkAssetOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerName   String?
  deviceName  String?
  adapterName String?

  ipv4Address String   @unique
  ipv6Address String?
  macAddress  String?  @unique

  subnetMask  String?
  gateway     String?
  dnsServer   String?
  dhcpEnabled Boolean?
  location    String?
  groupName   String   @default("일반")
  displayOrder Int     @default(0)
  status      String   @default("IN_USE") // IN_USE, RESERVED, AVAILABLE, RETIRED
  source      String?
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
  @@index([groupName])
  @@index([status])
}

// ============ Paper Management (논문 관리) ============
// status: WRITING, SUBMITTED, UNDER_REVIEW, REVISION, ACCEPTED, PUBLISHED

model LabPaper {
  id         String           @id @default(cuid())
  title      String
  abstract   String?
  journal    String?
  status     String           @default("WRITING") // WRITING, SUBMITTED, UNDER_REVIEW, REVISION, ACCEPTED, PUBLISHED
  year       Int?
  doi        String?
  url        String?
  filename   String?
  size       Int?
  mimeType   String?
  uploaderId String
  uploader   User             @relation("LabPaperUploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  authors    LabPaperAuthor[]
  revisions  PaperRevision[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model LabPaperAuthor {
  id      String   @id @default(cuid())
  paperId String
  paper   LabPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  userId  String
  user    User     @relation("LabPaperAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([paperId, userId])
}

model PaperRevision {
  id         String   @id @default(cuid())
  paperId    String
  paper      LabPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  version    Int
  note       String?
  url        String
  filename   String
  size       Int
  mimeType   String?
  uploaderId String
  uploader   User     @relation("PaperRevisionUploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model ReadingPaper {
  id          String   @id @default(cuid())
  title       String
  authors     String?  // 외부 논문 저자 (텍스트)
  year        Int?
  abstract    String?
  externalUrl String?  // DOI/arXiv 링크
  pptUrl      String?
  pptFilename String?
  pptSize     Int?
  pptMimeType String?
  readerId    String
  reader      User     @relation("ReadingPaperReader", fields: [readerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============ Post Interactions (게시글 상호작용) ============

// 게시글 추천 (좋아요)
model PostLike {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

// 투표
model Poll {
  id            String       @id @default(cuid())
  postId        String       @unique
  post          Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  question      String       // 투표 질문
  isMultiple    Boolean      @default(false)  // 복수 선택 허용 여부
  isAnonymous   Boolean      @default(false)  // 익명 투표 여부
  endsAt        DateTime?    // 투표 마감일 (null이면 무기한)
  options       PollOption[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

// 투표 옵션
model PollOption {
  id        String     @id @default(cuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text      String     // 옵션 텍스트
  order     Int        @default(0)  // 표시 순서
  votes     PollVote[]
  createdAt DateTime   @default(now())
}

// 투표 기록
model PollVote {
  id        String     @id @default(cuid())
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([optionId, userId])
}

// ============ Google Calendar Sync (구글 캘린더 연동) ============

model GoogleCalendarSync {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarId    String   // Google Calendar ID (e.g., "primary", "email@gmail.com")
  calendarName  String   // 표시 이름
  isShared      Boolean  @default(false) // 다른 멤버에게 공유 여부
  color         String?  // 표시 색상
  category      String   @default("OTHER") // SEMINAR, MEETING, LAB_MEETING, DEADLINE, TRIP, VACATION, OTHER
  isImportant   Boolean  @default(false) // 중요 일정 여부
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, calendarId])
}

// 개별 Google 이벤트 오버라이드 (카테고리, 중요 설정)
model GoogleEventOverride {
  id             String   @id @default(cuid())
  googleEventId  String   @unique // composite ID: "google_{calendarId}_{eventId}"
  category       String?  // null = 캘린더 단위 설정 사용
  isImportant    Boolean? // null = 캘린더 단위 설정 사용
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// 시간표
model Timetable {
  id        String           @id @default(cuid())
  userId    String           @unique
  user      User             @relation("TimetableOwner", fields: [userId], references: [id], onDelete: Cascade)
  semester  String           // "2026-1" 형식
  pdfUrl    String?          // 업로드한 원본 PDF URL
  entries   TimetableEntry[]
  updatedAt DateTime         @updatedAt
  createdAt DateTime         @default(now())
}

model TimetableEntry {
  id          String    @id @default(cuid())
  timetableId String
  timetable   Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  dayOfWeek   Int       // 0=월, 1=화, 2=수, 3=목, 4=금, 5=토
  startTime   String    // "09:00" 형식
  endTime     String    // "10:15" 형식
  courseName  String    // 과목명
  professor   String?   // 교수명
  room        String?   // 강의실
  color       String?   // 표시 색상
  createdAt   DateTime  @default(now())

  @@index([timetableId])
}
